<div class="row">
  <div class="col-12">
    <h1 class="text-center mb-4">Comments</h1>
    <div class="row">
      <% @comments.each do |comment| %>
        <div class="col-md-4 mb-4">
          <div class="card bg-secondary text-light">
            <div class="card-body">
              <p class="card-text"><%= raw comment.content %></p>
              <p class="card-text"><small class="text-muted">Post: <%= comment.post.title %></small></p>
              <p class="card-text"><small class="text-muted">User: <%= comment.user&.name || comment.name %></small></p>
              <%= link_to 'Edit', edit_comment_path(comment), class: "btn btn-primary btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="text-center">
      <%= link_to 'Back to Posts', posts_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
