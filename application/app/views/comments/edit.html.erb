<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card bg-secondary text-light">
      <div class="card-body">
        <h1 class="card-title text-center">Edit Comment</h1>

        <%= form_for @comment do |f| %>
          <div class="mb-3">
            <%= f.label :content, class: "form-label" %>
            <%= f.text_area :content, class: "form-control", rows: 3 %>
          </div>
          <div class="d-grid">
            <%= f.submit "Update Comment", class: "btn btn-warning" %>
          </div>
        <% end %>

        <div class="text-center mt-3">
          <%= link_to 'Back to Comments', comments_path, class: "btn btn-link" %>
        </div>
      </div>
    </div>
  </div>
</div>