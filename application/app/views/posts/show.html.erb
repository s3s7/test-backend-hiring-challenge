<div class="row">
  <div class="col-12">
    <div class="card bg-secondary text-light mb-4">
      <div class="card-body">
        <h1 class="card-title"><%= raw @post.title %></h1>
        <p class="card-text">Author: <%= @post.user.name %></p>
        <div class="card-text"><%= raw @post.content %></div>
      </div>
    </div>

    <h2>Comments</h2>
    <% @post.comments.each do |comment| %>
      <div class="card bg-dark text-light mb-3">
        <div class="card-body">
          <p class="card-text"><%= raw comment.content %></p>
          <p class="card-text"><small class="text-muted">By: <%= comment.user.name %></small></p>
        </div>
      </div>
    <% end %>

    <div class="mt-4">
      <%= link_to 'Edit Post', edit_post_path(@post), class: "btn btn-warning me-2" %>
      <%= link_to 'Back to Posts', posts_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>