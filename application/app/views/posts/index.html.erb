<div class="row">
  <div class="col-12">
    <h1 class="text-center mb-4">Awesome Night Blog Posts</h1>
    <div class="row">
      <% @posts.each do |post| %>
        <div class="col-md-4 mb-4">
          <div class="card bg-secondary text-light">
            <div class="card-body">
              <h5 class="card-title"><%= raw post.title %></h5>
              <p class="card-text">Author: <%= post.user.name %></p>
              <%= link_to 'Read More', post_path(post), class: "btn btn-primary" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="text-center">
      <%= link_to 'Create New Post', new_post_path, class: "btn btn-success" %>
    </div>
  </div>
</div>